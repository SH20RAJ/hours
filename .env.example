# ─────────────────────────────────────────────────────────────────────────────
# Hours — environment variables (frontend)
# Copy to `.env.local` and fill in to enable OPTIONAL auth + cloud sync.
# Leave unset to run Hours fully local-first with no account (default).
# ─────────────────────────────────────────────────────────────────────────────

# Stack Auth — from your project dashboard (https://app.stack-auth.com)
# Both must be set for sign-in to appear in the UI.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=

# The deployed sync API Worker. Set this to turn on the "Sync now" button.
# Already deployed at: https://hours-api.shraj.workers.dev
NEXT_PUBLIC_SYNC_API_URL=https://hours-api.shraj.workers.dev
