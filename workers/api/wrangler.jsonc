{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hours-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hours-db",
      "database_id": "f297e532-179f-410c-9562-9f3f71b25cb4"
    }
  ],
  "vars": {
    "STACK_PROJECT_ID": "",
    "ALLOWED_ORIGIN": "*"
  }
}
