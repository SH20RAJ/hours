{
  "name": "hours-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute hours-db --remote --file=./schema.sql",
    "db:apply-local": "wrangler d1 execute hours-db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241127.0",
    "typescript": "5.6.3",
    "wrangler": "4.69.0"
  }
}
